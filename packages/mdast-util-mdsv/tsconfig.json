{
  "extends": "../../tsconfig.json",
  "references": [
    { "path": "../constants" },
    { "path": "../micromark-extension-mdsv" }
  ],
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": true
