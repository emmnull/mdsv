{
  "name": "micromark-extension-mdsv",
  "version": "0.0.0-dev",
  "description": "Tokenize and serialize svelte syntax inside markdown",
  "keywords": [
    "markdown",
    "svelte",
    "micromark",
    "unified",
    "extension"
  ],
  "license": "MIT",
  "author": "Emmanuel Beaudry Marchand <emmbema@gmail.com>",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/**/*.d.ts"
  ],
  "scripts": {
    "build": "tsc --build --clean && tsc --build",
    "build:watch": "tsc --build --clean && tsc --build --watch --preserveWatchOutput",
    "test": "node --test",
    "test:watch": "node --test --watch"
  },
  "devDependencies": {
    "@mdsv/constants": "workspace:^",
    "micromark": "^4.0.2",
    "micromark-core-commonmark": "^2.0.3",
    "micromark-extension-frontmatter": "^2.0.0",
    "micromark-factory-space": "^2.0.1",
    "micromark-util-character": "^2.1.1",
    "micromark-util-combine-extensions": "^2.0.1",
    "micromark-util-html-tag-name": "^2.0.1",
    "micromark-util-resolve-all": "^2.0.1",
    "micromark-util-symbol": "^2.0.1",
    "micromark-util-types": "^2.0.2"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    }
  }
}
