{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "strict": true,
    "skipLibCheck": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "esnext",
    "esModuleInterop": true,
    "sourceMap": true,
    "declarationMap": true
  },
  "exclude": ["node_modules"]
}
